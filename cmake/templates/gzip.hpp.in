#ifndef MCNBT_GZIP_HPP
#define MCNBT_GZIP_HPP

#include <cstddef> // size_t
#include <limits>  // numeric_limits
#include <string>  // string
#include <istream>

#ifndef ZLIB_CONST
    #define ZLIB_CONST
#endif // !ZLIB_CONST
#include <zlib.h>

namespace nbt
{

namespace gzip
{

/** @brief Checks if the given data is compressed using Gzip or Zlib. */
static inline bool isCompressed(const char* data, size_t size) noexcept
{
    if (size < 2)
        return false;

    const unsigned char byte1 = data[0];
    const unsigned char byte2 = data[1];

    const bool isZlib = (byte1 == 0x78 && (byte2 == 0x9C || byte2 == 0x01 || byte2 == 0xDA || byte2 == 0x5E));
    const bool isGzip = (byte1 == 0x1F && byte2 == 0x8B);

    return isZlib || isGzip;
}

/** @overload */
static inline bool isCompressed(const std::string& data) noexcept
{
    return isCompressed(data.c_str(), data.size());
}

/** @overload */
static inline bool isCompressed(std::istream& is) noexcept
{
    const auto origin = is.tellg();

    const int byte1 = is.get();
    if (byte1 == EOF)
    {
        is.clear();
        is.seekg(origin);
        return false;
    }

    const int byte2 = is.get();
    is.clear();
    is.seekg(origin);
    if (byte2 == EOF)
        return false;

    const bool isZlib = (byte1 == 0x78 && (byte2 == 0x9C || byte2 == 0x01 || byte2 == 0xDA || byte2 == 0x5E));
    const bool isGzip = (byte1 == 0x1F && byte2 == 0x8B);

    return isZlib || isGzip;
}

/**
 * @brief  Compresses the given data using Gzip.
 * @return The compressed data if success else the empty string.
 */
static inline std::string compress(const char* data, size_t size) noexcept
{
    if (size > std::numeric_limits<uInt>::max())
        return "";

    z_stream stream;
    stream.zalloc   = Z_NULL;
    stream.zfree    = Z_NULL;
    stream.opaque   = Z_NULL;
    stream.avail_in = 0;
    stream.next_in  = Z_NULL;

    constexpr int level       = Z_DEFAULT_COMPRESSION;
    constexpr int method      = Z_DEFLATED;
    constexpr int windowsBits = 15 + 16;
    constexpr int memLevel    = 8;
    constexpr int strategy    = Z_DEFAULT_STRATEGY;

    if (deflateInit2(&stream, level, method, windowsBits, memLevel, strategy) != Z_OK)
        return "";

    stream.next_in  = reinterpret_cast<z_const Bytef*>(data);
    stream.avail_in = static_cast<uInt>(size);

    std::string compressed;
    uInt compressedSize = 0;
    const uInt increaseSize = static_cast<uInt>(size) / 2 + 1024;
    do
    {
        if (compressed.size() < (compressedSize + increaseSize))
            compressed.resize(compressedSize + increaseSize);

        stream.avail_out = increaseSize;
        stream.next_out  = reinterpret_cast<Bytef*>(&compressed[0] + compressedSize);

        const int ret = deflate(&stream, Z_FINISH);
        if (ret != Z_STREAM_END && ret != Z_OK)
        {
            deflateEnd(&stream);
            return "";
        }

        compressedSize += increaseSize - stream.avail_out;
    } while (stream.avail_out == 0);

    deflateEnd(&stream);
    compressed.resize(compressedSize);
    return compressed;
}

/** @overload */
static inline std::string compress(const std::string& data) noexcept
{
    return compress(data.c_str(), data.size());
}

/**
 * @brief  Decompresses the given data using Gzip.
 * @return The decompressed data if success else the empty string.
 */
static inline std::string decompress(const char* data, size_t size) noexcept
{
    if (size * 2 > std::numeric_limits<uInt>::max())
        return "";

    z_stream stream;
    stream.zalloc   = Z_NULL;
    stream.zfree    = Z_NULL;
    stream.opaque   = Z_NULL;
    stream.avail_in = 0;
    stream.next_in  = Z_NULL;

    constexpr int windowsBits = 15 + 32;
    if (inflateInit2(&stream, windowsBits) != Z_OK)
        return "";

    stream.next_in  = reinterpret_cast<z_const Bytef*>(data);
    stream.avail_in = static_cast<uInt>(size);

    std::string decompressed;
    uInt decompressedSize = 0;
    do
    {
        decompressed.resize(size * 2 + decompressedSize);

        stream.avail_out = static_cast<uInt>(decompressed.size() - decompressedSize);
        stream.next_out  = reinterpret_cast<Bytef*>(&decompressed[0] + decompressedSize);

        const int ret = inflate(&stream, Z_NO_FLUSH);
        if (ret != Z_STREAM_END && ret != Z_OK)
        {
            inflateEnd(&stream);
            return "";
        }

        decompressedSize = static_cast<uInt>(decompressed.size()) - stream.avail_out;
    } while (stream.avail_out == 0);

    inflateEnd(&stream);
    decompressed.resize(decompressedSize);
    return decompressed;
}

/** @overload */
static inline std::string decompress(const std::string& data) noexcept
{
    return decompress(data.c_str(), data.size());
}

} // namespace gzip

} // namespace nbt

#endif // !MCNBT_GZIP_HPP
